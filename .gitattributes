* text=auto
*.cs text eol=lf
*.md text eol=lf
*.unity text eol=lf whitespace=-blank-at-eol
# Unity serializes empty YAML scalars with trailing spaces in generated assets.
*.prefab text eol=lf whitespace=-blank-at-eol
*.asset text eol=lf whitespace=-blank-at-eol
*.controller text eol=lf whitespace=-blank-at-eol
*.mat text eol=lf whitespace=-blank-at-eol
*.meta text eol=lf whitespace=-blank-at-eol
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Canonical arena evidence is byte-hashed by the headless importer.
ArtSource/Original/ArtPass-v1/Environment/ArenaStone/*.json text eol=lf

# Noncompiled research source hashes use canonical LF text.
ArtSource/Original/ArtPass-v1/Experiments/RifleBatch/**/*.txt text eol=lf
ArtSource/Original/ArtPass-v1/Experiments/RifleBatch/**/*.patch text eol=lf
ArtSource/Original/ArtPass-v1/Experiments/RifleBatch/**/*.py text eol=lf
ArtSource/Original/ArtPass-v1/Experiments/RifleBatch/**/*.ps1 text eol=lf
ArtSource/Original/ArtPass-v1/Experiments/RifleBatch/**/*.json text eol=lf
ArtSource/Original/ArtPass-v1/Experiments/RifleBatch/**/*.md text eol=lf
ArtSource/Original/ArtPass-v1/Experiments/RifleBatch/**/*.html text eol=lf

# Installed nature authority and production geometry are byte-hashed.
ArtSource/Original/ArtPass-v1/Nature/GardenNature/*.json text eol=lf
ArtSource/Original/ArtPass-v1/Nature/GardenNature/**/*.json text eol=lf
ArtSource/Original/ArtPass-v1/Nature/GardenNature/*.csv text eol=lf
ArtSource/Original/ArtPass-v1/Animation/Standing/**/*.json text eol=lf
ArtSource/Original/ArtPass-v1/Animation/Standing/*.json text eol=lf
ArtSource/Original/ArtPass-v1/Animation/Standing/*.csv text eol=lf
ArtSource/Original/ArtPass-v1/Animation/FirstPersonReady/*.json text eol=lf
ArtSource/Original/ArtPass-v1/Animation/FirstPersonReady/*.csv text eol=lf
